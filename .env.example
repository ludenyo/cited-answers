# Copy to .env and fill in. .env is gitignored; never commit real values.

ANTHROPIC_API_KEY=
# A small, cheap model by default. Thinking tokens count against the max.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=2048
# Optional. Model for the input classifier; defaults to ANTHROPIC_MODEL when unset.
# ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5

# Matches the defaults in docker-compose.yml.
DATABASE_URL=postgresql://cited:cited@localhost:5435/cited_answers

# Optional. When set, database tests run in a throwaway schema; otherwise they skip.
# Point it at the same database as above; tests create and drop their own schema.
TEST_DATABASE_URL=postgresql://cited:cited@localhost:5435/cited_answers

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional. Keeps test and production traces apart in Langfuse dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development
# Set to false to turn tracing off. Tracing is also off when the keys above are empty.
# LANGFUSE_TRACING_ENABLED=false

# Public demo protections (all optional; see "Public demo" in the README). The Docker image
# sets these defaults; locally, unset means the per-IP limit from config/app.yaml and no cap.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=3600
# DAILY_ASK_CAP=300
# TRUST_PROXY_HOPS=1
